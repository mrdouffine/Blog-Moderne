APP_NAME="Blog Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=fr
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# BASE DE DONNÉES
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blog_db
DB_USERNAME=blog_user
DB_PASSWORD=

# =============================================================================
# CACHE & SESSIONS
# =============================================================================
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
SESSION_DRIVER=file
SESSION_LIFETIME=120

# =============================================================================
# FILES DE MESSAGES (QUEUE)
# =============================================================================
QUEUE_CONNECTION=database

# =============================================================================
# SANCTUM — AUTHENTIFICATION API
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1
SESSION_DOMAIN=localhost

# =============================================================================
# MAIL
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@blog.local"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# AWS S3 (optionnel — si stockage cloud activé)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# REDIS (optionnel — remplacer CACHE_DRIVER et QUEUE_CONNECTION si activé)
# =============================================================================
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# VITE (si frontend couplé au projet)
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
VITE_API_URL="${APP_URL}"
